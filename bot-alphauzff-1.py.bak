@dp.callback_query(F.data.startswith("virt_num_"))
async def buy_virtual_number(callback: CallbackQuery):
    country = callback.data.replace("virt_num_", "")
    price = VIRTUAL_NUMBERS.get(country)
    
    if price is None:
        await callback.answer("❌ Davlat topilmadi", show_alert=True)
        return
    
    db = load_db()
    user = get_user(db, callback.from_user.id)
    
    if user["balance"] < price:
        await callback.answer(
            f"❌ Balansingiz yetarli emas!\nKerak: {price:,} so'm\nMavjud: {user['balance']:,} so'm",
            show_alert=True,
        )
        return
    
    user["balance"] -= price
    user["history"].append({
        "type": "virtual_number",
        "country": country,
        "amount": price,
        "time": str(datetime.now())
    })
    save_db(db)
    
    await callback.message.edit_text(
        f"✅ Buyurtma qabul qilindi!\n"
        f"{country} — {price:,} so'm\n\n"
        f"💰 Qolgan balansingiz: {user['balance']:,} so'm\n\n"
        f"Admin nomerni tekshirib sizga yuboradi. ⏳",
        reply_markup=main_menu(),
    )
    
    await bot.send_message(
        ADMIN_ID,
        f"🌐 Yangi Virtual nomer buyurtma!\n"
        f"👤 {callback.from_user.full_name} (ID: {callback.from_user.id})\n"
        f"🌍 {country}\n"
        f"💵 {price:,} so'm\n\n"
        f"Nomerni yuboring: /reply_{callback.from_user.id} <nomer>",
        parse_mode="HTML",
    )
    await callback.answer()


