# ---------- JSON baza ----------
def load_db():
    if not os.path.exists(DB_FILE):
        return {"users": {}}
    with open(DB_FILE, "r", encoding="utf-8") as f:
        return json.load(f)


def save_db(db):
    with open(DB_FILE, "w", encoding="utf-8") as f:
        json.dump(db, f, ensure_ascii=False, indent=2)


def get_user(db, user_id):
    uid = str(user_id)
    if uid not in db["users"]:
        db["users"][uid] = {"balance": 0, "history": [], "subscribed": False}
    return db["users"][uid]


# ---------- FSM holatlari ----------
class TopUp(StatesGroup):
    waiting_check = State()


class AdminHelp(StatesGroup):
    waiting_message = State()


class TelegramAccountBuy(StatesGroup):
    waiting_choice = State()


class PremiumAccountBuy(StatesGroup):
    waiting_choice = State()


class VirtualNumberBuy(StatesGroup):
    waiting_choice = State()


class YoutubeStreamBuy(StatesGroup):
    waiting_choice = State()


# ---------- Klaviaturalar ----------
def main_menu():
    kb = [
        [InlineKeyboardButton(text="☀️ Hisob to'ldirish", callback_data="topup")],
        [InlineKeyboardButton(text="📱 Tayyor Telegram Akkauntlar", callback_data="telegram_accounts")],
        [InlineKeyboardButton(text="🌐 Virtual Nomerlar", callback_data="virtual_numbers")],
        [InlineKeyboardButton(text="👑 Premium Telegram Akkauntlar", callback_data="premium_accounts")],
        [InlineKeyboardButton(text="📺 YouTube Stream Nomerlar", callback_data="youtube_stream")],
        [InlineKeyboardButton(text="🆘 Admin yordam", callback_data="admin_help")],
    ]
    return InlineKeyboardMarkup(inline_keyboard=kb)


def back_button(target="back_main"):
    kb = [[InlineKeyboardButton(text="⬅️ Orqaga", callback_data=target)]]
    return InlineKeyboardMarkup(inline_keyboard=kb)


def telegram_accounts_menu():
    kb = []
    for idx, acc in enumerate(TELEGRAM_ACCOUNTS):
        kb.append([InlineKeyboardButton(
            text=f"{acc['nomer']} — {acc['narxi']:,} so'm",
            callback_data=f"teleacc_{idx}"
        )])
    kb.append([InlineKeyboardButton(text="⬅️ Orqaga", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def premium_accounts_menu():
    kb = []
    for name, price in PREMIUM_ACCOUNTS.items():
        kb.append([InlineKeyboardButton(
            text=f"{name} — {price:,} so'm",
            callback_data=f"prem_acc_{name}"
        )])
    kb.append([InlineKeyboardButton(text="⬅️ Orqaga", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def virtual_numbers_menu():
    kb = []
    for name, price in VIRTUAL_NUMBERS.items():
        kb.append([InlineKeyboardButton(
            text=f"{name} — {price:,} so'm",
            callback_data=f"virt_num_{name}"
        )])
    kb.append([InlineKeyboardButton(text="⬅️ Orqaga", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


def youtube_stream_menu():
    kb = []
    for name, price in YOUTUBE_STREAM.items():
        kb.append([InlineKeyboardButton(
            text=f"{name} — {price:,} so'm",
            callback_data=f"yt_stream_{name}"
        )])
    kb.append([InlineKeyboardButton(text="⬅️ Orqaga", callback_data="back_main")])
    return InlineKeyboardMarkup(inline_keyboard=kb)


# ---------- /start ----------
@dp.message(CommandStart())
async def start_handler(message: Message, state: FSMContext):
    await state.clear()
    db = load_db()
    user = get_user(db, message.from_user.id)
    
    # Kanal obunasi tekshiruvi (opsional - qanday qilib tekshirish kerak?)
    # Shu yerda siz kanal obunasini tekshirsangiz bo'ladi yoki shunchaki obuna so'rasangiz
    if not user["subscribed"]:
        await message.answer(
            f"👋 Assalomu alaykum, {message.from_user.full_name}!\n\n"
            f"🔔 Botdan foydalanish uchun avval kanalga obuna bo'ling:\n"
            f"<a href='{CHANNEL_URL}'>📢 {CHANNEL_URL}</a>\n\n"
            f"Obuna bo'lganingizdan keyin /start ni qayta bosing.",
            parse_mode="HTML"
        )
        return
    
    save_db(db)

    caption = (
        f"☀️ Assalomu alaykum, {message.from_user.full_name}!\n\n"
        "🌴 Alpha Nomer Servisiga xush kelibsiz — tezkor, ishonchli va qulay xizmat sizni kutmoqda.\n\n"
        f"💰 Balansingiz: <b>{user['balance']:,} so'm</b>\n\n"
        "Quyidagi bo'limdan birini tanlang 👇"
    )

    if os.path.exists(LOGO_FILE):
        await message.answer_photo(
            photo=FSInputFile(LOGO_FILE),
            caption=caption,
            parse_mode="HTML",
            reply_markup=main_menu(),
        )
    else:
        await message.answer(
            caption,
            parse_mode="HTML",
            reply_markup=main_menu(),
        )


@dp.callback_query(F.data == "back_main")
async def back_main(callback: CallbackQuery, state: FSMContext):
    await state.clear()
    db = load_db()
    user = get_user(db, callback.from_user.id)
    await callback.message.edit_text(
        f"💰 Balansingiz: <b>{user['balance']:,} so'm</b>\n\n🏠 Bosh menyu:",
        parse_mode="HTML",
        reply_markup=main_menu(),
    )
    await callback.answer()


