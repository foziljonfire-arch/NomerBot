    await callback.answer()


@dp.callback_query(F.data.startswith("teleacc_"))
async def buy_telegram_account(callback: CallbackQuery):
    idx = int(callback.data.replace("teleacc_", ""))
    acc = TELEGRAM_ACCOUNTS[idx]
    
    db = load_db()
    user = get_user(db, callback.from_user.id)
    price = acc["narxi"]
    
    if user["balance"] < price:
        await callback.answer(
            f"❌ Balansingiz yetarli emas!\nKerak: {price:,} so'm\nMavjud: {user['balance']:,} so'm",
            show_alert=True,
        )
        return
    
    user["balance"] -= price
    user["history"].append({
        "type": "telegram_account",
        "nomer": acc["nomer"],
        "amount": price,
        "time": str(datetime.now())
    })
    save_db(db)
    
    await callback.message.edit_text(
        f"✅ Buyurtma qabul qilindi!\n"
        f"📱 Nomer: {acc['nomer']}\n"
        f"💵 {price:,} so'm\n\n"
        f"💰 Qolgan balansingiz: {user['balance']:,} so'm\n\n"
        f"Admin akkauntni tekshirib sizga yuboradi.",
        reply_markup=main_menu(),
    )
    
    await bot.send_message(
        ADMIN_ID,
        f"📱 Yangi Telegram akkaunt buyurtma!\n"
        f"👤 {callback.from_user.full_name} (ID: {callback.from_user.id})\n"
        f"📞 Nomer: {acc['nomer']}\n"
        f"💵 {price:,} so'm\n\n"
        f"Javob berish: /reply_{callback.from_user.id} <akkaunt ma'lumotlari>",
        parse_mode="HTML",
    )
    await callback.answer()


