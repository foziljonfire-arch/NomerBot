    )


# ---------- Admin javob berishi ----------
@dp.message(F.text.startswith("/reply_"))
async def admin_reply(message: Message):
    if message.from_user.id != ADMIN_ID:
        return
    try:
        parts = message.text.split(" ", 1)
        user_id = int(parts[0].replace("/reply_", ""))
        text = parts[1]
        await bot.send_message(user_id, f"📩 <b>Admindan javob:</b>\n{text}", parse_mode="HTML")
        await message.answer("✅ Javob yuborildi.")
    except (IndexError, ValueError):
        await message.answer("❌ Format: /reply_USERID javob matni")


# ---------- Admin: foydalanuvchi balansini ko'rish ----------
@dp.message(F.text.startswith("/balance_"))
async def admin_check_balance(message: Message):
    if message.from_user.id != ADMIN_ID:
        return
    try:
        user_id = message.text.replace("/balance_", "").strip()
        db = load_db()
        user = get_user(db, user_id)
        await message.answer(f"👤 ID: {user_id}\n💰 Balans: {user['balance']:,} so'm")
    except Exception:
        await message.answer("❌ Foydalanuvchi topilmadi.")


# ---------- Flask veb-server ----------
app = Flask(__name__)


@app.route("/")
def home():
    return "Alpha Nomer Bot ishlayapti ✅"


def run_flask():
    port = int(os.environ.get("PORT", 8080))
    app.run(host="0.0.0.0", port=port)


async def main():
    print("✅ Alpha Nomer Bot ishga tushdi — 24/7 rejimda...")
    threading.Thread(target=run_flask, daemon=True).start()
    await dp.start_polling(bot, allowed_updates=dp.resolve_used_update_types())


if __name__ == "__main__":
    asyncio.run(main())
