@dp.message(AdminHelp.waiting_message)
async def forward_to_admin(message: Message, state: FSMContext):
    await state.clear()
    await message.answer("✅ Xabaringiz adminga yuborildi.", reply_markup=main_menu())
    await bot.send_message(
        ADMIN_ID,
        f"🆘 Yordam so'rovi!\n"
